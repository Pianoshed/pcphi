# Copy to .env — never commit .env
APP_ENV=development            # set to "production" when deployed
SECRET_KEY=                    # required in production: python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=                  # blank = SQLite in instance/. Production: postgresql://user:pass@host/db
SITE_URL=http://127.0.0.1:5000 # production: https://www.participativecare.org.ng ; public base URL (canonical links, sitemap, unsubscribe links)
UPLOAD_DIR=                    # blank = instance/uploads. Production: path on a persistent disk
TRUSTED_PROXIES=1              # number of reverse proxies in front (Render = 1)
# First administrator (used by: flask create-admin). Password may instead be typed at the prompt.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional SMTP — leave blank and the site will never claim an email was sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
